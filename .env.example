# SQLAlchemy connection string.
# Defaults to a local SQLite file at data/processed/twin.db when unset.
# To migrate to PostgreSQL later, set this to something like:
#   postgresql+psycopg2://user:password@host:5432/dbname
# No code changes are required for that switch.
DATABASE_URL=

# API key for the generative semantic fusion layer (Claude-class model).
ANTHROPIC_API_KEY=
